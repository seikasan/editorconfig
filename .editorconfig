# Unity C# / Rider code style
# Roslyn-compatible rules are used where possible; Rider-only keys are marked.
root = true

# ============================================================
# Common text format
# ============================================================

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# ============================================================
# C# format / syntax / inspections
# ============================================================

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4

# ------------------------------------------------------------
# Accessibility
# ------------------------------------------------------------
# Explicit access modifiers, except public interface members.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_diagnostic.IDE0040.severity = warning

# ------------------------------------------------------------
# Built-in type names
# ------------------------------------------------------------
# int/string/bool instead of Int32/String/Boolean.
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion
dotnet_diagnostic.IDE0049.severity = suggestion

# ------------------------------------------------------------
# var: apparent type or manually justified readability
# ------------------------------------------------------------
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
# Suggest var when evident, but do not insist on explicit type elsewhere.
# This leaves room for long ZLinq types and foreach variables.
dotnet_diagnostic.IDE0007.severity = suggestion
dotnet_diagnostic.IDE0008.severity = none

# Rider: recognize more obviously typed generic calls, such as
# GetComponent<Rigidbody>(), by using Rider's own detection logic.
csharp_use_roslyn_logic_for_evident_types = false
csharp_for_built_in_types = use_explicit_type
csharp_for_simple_types = use_var_when_evident
csharp_for_other_types = use_var_when_evident

# ------------------------------------------------------------
# Braces / Allman / compact members
# ------------------------------------------------------------
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true

# One-line guard clauses are allowed; multiline statements need braces.
# A special "only guard clauses may omit braces" rule needs an analyzer.
csharp_prefer_braces = when_multiline:warning
dotnet_diagnostic.IDE0011.severity = warning

# Rider: braces around one-statement if blocks are permitted, not redundant.
# Do not suggest removing them; one-line guards without braces remain allowed.
resharper_remove_redundant_braces_highlighting = none

# Preserve short auto-properties and if (invalid) return; as written.
# This also preserves other existing one-line blocks/statements.
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = true

# ------------------------------------------------------------
# Indentation and spacing
# ------------------------------------------------------------
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = true
csharp_indent_switch_labels = true

csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_after_comma = true
csharp_space_before_comma = false
csharp_space_after_cast = false
csharp_space_around_binary_operators = before_and_after
csharp_space_between_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_between_method_declaration_name_and_open_parenthesis = false

dotnet_diagnostic.IDE0055.severity = warning

# ------------------------------------------------------------
# Expression bodies
# ------------------------------------------------------------
# public int Health => _health; is preferred if it fits on one line.
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
dotnet_diagnostic.IDE0025.severity = suggestion

# Allow one-line expression-bodied methods without warnings.
# Expression bodies are not required; block-bodied methods remain valid.
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
dotnet_diagnostic.IDE0022.severity = none

# Rider: do not flag either method-body style for conversion.
resharper_arrange_method_or_operator_body_highlighting = none

# ------------------------------------------------------------
# Namespace / usings
# ------------------------------------------------------------
# Unity's C# 9-compatible block-scoped namespace syntax.
csharp_style_namespace_declarations = block_scoped:warning
dotnet_diagnostic.IDE0160.severity = warning
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_sort_system_directives_first = true

# Namespace path need not match folders (both Roslyn and Rider).
dotnet_style_namespace_match_folder = false:suggestion
dotnet_diagnostic.IDE0130.severity = none
resharper_check_namespace_highlighting = none

# Flag unused using directives as warnings (Roslyn + Rider).
dotnet_diagnostic.IDE0005.severity = warning
resharper_redundant_using_directive_highlighting = warning

# ------------------------------------------------------------
# Modifier order / readonly
# ------------------------------------------------------------
csharp_preferred_modifier_order = public, private, protected, internal, static, extern, new, virtual, abstract, sealed, override, readonly, unsafe, volatile, async:warning
dotnet_diagnostic.IDE0036.severity = warning

dotnet_style_readonly_field = true:suggestion
dotnet_diagnostic.IDE0044.severity = suggestion

# ============================================================
# Naming styles
# ============================================================

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# s_camelCase for mutable private static fields.
dotnet_naming_style.static_underscore_camel_case.required_prefix = s_
dotnet_naming_style.static_underscore_camel_case.capitalization = camel_case

# Async-suffixed method names.
dotnet_naming_style.async_pascal_case.required_suffix = Async
dotnet_naming_style.async_pascal_case.capitalization = pascal_case

dotnet_naming_style.interface_pascal_case.required_prefix = I
dotnet_naming_style.interface_pascal_case.capitalization = pascal_case

dotnet_naming_style.type_parameter_pascal_case.required_prefix = T
dotnet_naming_style.type_parameter_pascal_case.capitalization = pascal_case

# ------------------------------------------------------------
# Type declarations: PascalCase (including delegates)
# ------------------------------------------------------------
dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate
dotnet_naming_symbols.types.applicable_accessibilities = *
dotnet_naming_rule.types.symbols = types
dotnet_naming_rule.types.style = pascal_case
dotnet_naming_rule.types.severity = warning

# Interfaces: IPascalCase
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
dotnet_naming_rule.interfaces.symbols = interfaces
dotnet_naming_rule.interfaces.style = interface_pascal_case
dotnet_naming_rule.interfaces.severity = warning

# Methods, properties, events, local functions: PascalCase.
# Event naming is retained for legacy compatibility, despite the
# project policy to avoid C# event declarations.
dotnet_naming_symbols.members.applicable_kinds = method, property, event, local_function
dotnet_naming_symbols.members.applicable_accessibilities = *
dotnet_naming_rule.members.symbols = members
dotnet_naming_rule.members.style = pascal_case
dotnet_naming_rule.members.severity = warning

# Methods and local functions with the async modifier must end in Async.
# This does NOT catch non-async Task/ValueTask/UniTask-returning methods.
dotnet_naming_symbols.async_methods.applicable_kinds = method, local_function
dotnet_naming_symbols.async_methods.applicable_accessibilities = *
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_rule.async_methods.symbols = async_methods
dotnet_naming_rule.async_methods.style = async_pascal_case
dotnet_naming_rule.async_methods.severity = warning

# Type parameters: T, TResult, TEntity, ...
dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_symbols.type_parameters.applicable_accessibilities = *
dotnet_naming_rule.type_parameters.symbols = type_parameters
dotnet_naming_rule.type_parameters.style = type_parameter_pascal_case
dotnet_naming_rule.type_parameters.severity = warning

# Parameters: camelCase
dotnet_naming_symbols.parameters.applicable_kinds = parameter
dotnet_naming_symbols.parameters.applicable_accessibilities = *
dotnet_naming_rule.parameters.symbols = parameters
dotnet_naming_rule.parameters.style = camel_case
dotnet_naming_rule.parameters.severity = warning

# Local variables: camelCase
dotnet_naming_symbols.locals.applicable_kinds = local
dotnet_naming_symbols.locals.applicable_accessibilities = local
dotnet_naming_rule.locals.symbols = locals
dotnet_naming_rule.locals.style = camel_case
dotnet_naming_rule.locals.severity = warning

# ------------------------------------------------------------
# Fields
# ------------------------------------------------------------
# Private instance fields (including readonly): _camelCase.
# A specific static rule below overrides this for mutable static fields.
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel_case
dotnet_naming_rule.private_fields.severity = warning

# Private mutable static fields: s_camelCase.
# More specific rules below keep const and static readonly PascalCase.
# C# const is implicitly static and readonly, so the private_const
# intersection rule further below is required.
dotnet_naming_symbols.private_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_fields.required_modifiers = static
dotnet_naming_rule.private_static_fields.symbols = private_static_fields
dotnet_naming_rule.private_static_fields.style = static_underscore_camel_case
dotnet_naming_rule.private_static_fields.severity = warning

# Public/internal/protected fields: PascalCase (if unavoidable).
dotnet_naming_symbols.non_private_fields.applicable_kinds = field
dotnet_naming_symbols.non_private_fields.applicable_accessibilities = public, internal, protected, protected_internal, private_protected
dotnet_naming_rule.non_private_fields.symbols = non_private_fields
dotnet_naming_rule.non_private_fields.style = pascal_case
dotnet_naming_rule.non_private_fields.severity = warning

# All const fields and local constants: PascalCase.
dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_rule.constants.symbols = constants
dotnet_naming_rule.constants.style = pascal_case
dotnet_naming_rule.constants.severity = warning

# Explicit overlap resolution: private const takes PascalCase,
# not the generic private field naming rule.
dotnet_naming_symbols.private_constants.applicable_kinds = field
dotnet_naming_symbols.private_constants.applicable_accessibilities = private
dotnet_naming_symbols.private_constants.required_modifiers = const
dotnet_naming_rule.private_constants.symbols = private_constants
dotnet_naming_rule.private_constants.style = pascal_case
dotnet_naming_rule.private_constants.severity = warning

# Private static readonly: PascalCase (exception to s_camelCase).
dotnet_naming_symbols.private_static_readonly.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly.required_modifiers = static, readonly
dotnet_naming_rule.private_static_readonly.symbols = private_static_readonly
dotnet_naming_rule.private_static_readonly.style = pascal_case
dotnet_naming_rule.private_static_readonly.severity = warning

# Non-private static readonly already uses PascalCase via
# non_private_fields; this dedicated rule documents that explicitly.
dotnet_naming_symbols.non_private_static_readonly.applicable_kinds = field
dotnet_naming_symbols.non_private_static_readonly.applicable_accessibilities = public, internal, protected, protected_internal, private_protected
dotnet_naming_symbols.non_private_static_readonly.required_modifiers = static, readonly
dotnet_naming_rule.non_private_static_readonly.symbols = non_private_static_readonly
dotnet_naming_rule.non_private_static_readonly.style = pascal_case
dotnet_naming_rule.non_private_static_readonly.severity = warning

# All naming violations: warning (also relevant for builds).
dotnet_diagnostic.IDE1006.severity = warning

# ------------------------------------------------------------
# Rider / Unity serialized-field naming (preserved from original)
# ------------------------------------------------------------
# Rider's Unity-specific type classifier; it checks names, not the
# presence of [SerializeField] or the private modifier themselves.
dotnet_naming_rule.unity_serialized_field_rule.import_to_resharper = true
dotnet_naming_rule.unity_serialized_field_rule.resharper_description = Unity serialized field
dotnet_naming_rule.unity_serialized_field_rule.resharper_guid = 5f0fdb63-c892-4d2c-9324-15c80b22a7ef
dotnet_naming_rule.unity_serialized_field_rule.severity = warning
dotnet_naming_rule.unity_serialized_field_rule.style = underscore_camel_case
dotnet_naming_rule.unity_serialized_field_rule.symbols = unity_serialized_field_symbols

dotnet_naming_symbols.unity_serialized_field_symbols.applicable_accessibilities = private
dotnet_naming_symbols.unity_serialized_field_symbols.applicable_kinds = field
dotnet_naming_symbols.unity_serialized_field_symbols.resharper_applicable_kinds = unity_serialised_field
dotnet_naming_symbols.unity_serialized_field_symbols.resharper_required_modifiers = instance

# ============================================================
# Generated C# code: omit style analysis
# ============================================================

[*.g.cs]
generated_code = true

[*.generated.cs]
generated_code = true
